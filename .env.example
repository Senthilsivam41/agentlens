# Runtime mode
AGENTLENS_ENVIRONMENT=development
AGENTLENS_AUTH_MODE=dev
AGENTLENS_DEV_TENANT_ID=local
AGENTLENS_DEV_ROLES=viewer,analyst,admin

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=agentlens
CLICKHOUSE_USERNAME=agentlens
CLICKHOUSE_PASSWORD=change-me

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_RAW_TOPIC=agentlens.otlp.traces.v1
KAFKA_SPAN_TOPIC=agentlens.spans.transient.v1
KAFKA_SCORE_TOPIC=agentlens.executions.score.v1
KAFKA_DLQ_TOPIC=agentlens.ingest.dlq.v1

# OpenAI-compatible semantic scoring. Never commit real credentials.
# Platform OpenAI: leave OPENAI_BASE_URL empty and use a sk-… key from platform.openai.com.
# OpenRouter: OPENAI_API_KEY=sk-or-v1-… plus:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OIDC pilot mode
OIDC_ISSUER=
OIDC_AUDIENCE=agentlens-api
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=

# Collector identity and hashing
AGENTLENS_HMAC_KEY=replace-with-at-least-32-random-bytes
AGENTLENS_TRANSIENT_KEY=replace-with-at-least-32-random-bytes
AGENTLENS_CLUSTER_ID=local-compose
AGENTLENS_TENANT_ID=local

# Web
API_HOST_PORT=18000
WEB_HOST_PORT=3000
NEXT_PUBLIC_AGENTLENS_API_URL=http://localhost:18000
